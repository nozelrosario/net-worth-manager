# Net Worth Manager - Optional Local & CI Configuration Reference
# Copy values into GitHub Repository Secrets for CI/CD or local .env files when building.

# ------------------------------------------------------------------
# Google Apps Script (Backend)
# ------------------------------------------------------------------
# Optional override if automatic Session.getEffectiveUser() detection is unavailable.
# Set in Apps Script Project Settings -> Script Properties as OWNER_EMAIL.
OWNER_EMAIL=

# ------------------------------------------------------------------
# Firebase Web Portal (Optional)
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SITE_PROD=
FIREBASE_SITE_UAT=
APPS_SCRIPT_URL_PROD=
APPS_SCRIPT_URL_UAT=

# ------------------------------------------------------------------
# Mobile App (Optional - Personal Builds / Universal Distribution)
# ------------------------------------------------------------------
# Leave APP_URL empty for Universal Distribution builds (runtime setup screen).
APP_URL=
APP_BUNDLE_ID=com.networthmanager.app
EAS_PROJECT_ID=
EXPO_OWNER=
